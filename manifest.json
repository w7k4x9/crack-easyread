{
  "manifest_version": 3,
  "name": "크랙 크게 읽기",
  "version": "1.0.0",
  "description": "크랙 채팅의 글자 크기를 키우고, 따옴표 대사에 반투명 강조를 넣습니다. 다른 기능은 없습니다.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://crack.wrtn.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "크랙 크게 읽기",
    "default_popup": "popup.html"
  }
}
